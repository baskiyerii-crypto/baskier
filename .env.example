# ==============================================================================
# BaskıYeri Üretim ve Geliştirme Ortamı Yapılandırma Şablonu (.env.example)
# Gerekli PHP Uzantıları: pdo, pdo_mysql / pdo_pgsql, pdo_sqlite, bcmath,
#                        mbstring, curl, gd, fileinfo, redis, intl
# ==============================================================================

APP_NAME=BaskıYeri
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://baskiyeri.com
APP_TIMEZONE=Europe/Istanbul
APP_LOCALE=tr
APP_FALLBACK_LOCALE=tr
APP_FAKER_LOCALE=tr_TR

APP_MAINTENANCE_DRIVER=cache
BCRYPT_ROUNDS=12

# ------------------------------------------------------------------------------
# Loglama ve Gözlemlenebilirlik (Observability)
# ------------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single,daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info
CORRELATION_ID_HEADER=X-Correlation-ID

# ------------------------------------------------------------------------------
# Veritabanı Yapılandırması (MySQL / PostgreSQL / SQLite)
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=baskiyeri
DB_USERNAME=baskiyeri_user
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# ------------------------------------------------------------------------------
# Oturum, Önbellek ve Kuyruk (Redis Önerilir)
# ------------------------------------------------------------------------------
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=redis
CACHE_PREFIX=by_cache_

QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# ------------------------------------------------------------------------------
# Dosya Depolama (Public CDN / Private KYC & Evrak S3 Depolama)
# ------------------------------------------------------------------------------
FILESYSTEM_DISK=public
PRIVATE_FILESYSTEM_DISK=private

# S3 Uyumlu Object Storage (MinIO, Hetzner, AWS S3, Cloudflare R2)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=baskiyeri-private
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ------------------------------------------------------------------------------
# iyzico Marketplace Entegrasyonu
# ------------------------------------------------------------------------------
PAYMENT_PROVIDER=iyzico
IYZICO_MODE=sandbox
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
IYZICO_WEBHOOK_SECRET=
ENABLE_SHOPIFY=false

# ------------------------------------------------------------------------------
# Kargo Entegrasyonu (BasitKargo)
# ------------------------------------------------------------------------------
BASITKARGO_API_KEY=
BASITKARGO_BASE_URL=https://api.basitkargo.com

# ------------------------------------------------------------------------------
# WhatsApp / Evolution API
# ------------------------------------------------------------------------------
EVOLUTION_BASE_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=

# ------------------------------------------------------------------------------
# Yapay Zekâ / İçerik Moderasyonu
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# E-Posta Yapılandırması (SMTP)
# ------------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailersend.net
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="bilgi@baskiyeri.com"
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------------------------
# Vite & Frontend Varlıkları
# ------------------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
