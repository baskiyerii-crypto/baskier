# Laravel API kokU (mobil ile ayni sozlesme)
# Coolify: public HTTPS kullan (ornek: https://baskiyeri.com/api/v1)
# Buildtime + Runtime; Available at Buildtime isaretli olsun.
LARAVEL_API_URL=http://127.0.0.1:8000/api/v1

# Blade sayfalari ve /storage gorselleri icin Laravel web kokU.
# Bos birakilirsa LARAVEL_API_URL'den /api/v1 atilarak turetilir.
LARAVEL_WEB_URL=http://127.0.0.1:8000

# Storefront'un public adresi (canonical, hreflang, sitemap)
# Coolify ilk denemede alt domain: https://vitrin.baskiyeri.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
